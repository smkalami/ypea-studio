  "functions": "def route_length(g):\n    if len(g) == 0:\n        return 0\n    return distance[0, g[0] + 1] + sum(distance[g[:-1] + 1, g[1:] + 1]) + distance[g[-1] + 1, 0]\n\ndef total_length(groups):\n    total = 0\n    for g in groups:\n        total += route_length(g)\n    return total\n\ndef heaviest_load(groups):\n    worst = 0\n    for g in groups:\n        load = sum(demand[g])\n        if load > worst:\n            worst = load\n    return worst\n",
  "objective": {
