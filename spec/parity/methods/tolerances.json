 "runs": [
  {
   "name": "relative_only_sa",
   "ypea": {
    "class": "SA",
    "kwargs": {
     "pop_size": 5
    }
   },
   "scales": [
    1.75,
    120.0,
    0.6
   ],
   "project": {
    "format": "ypea-studio-project",
    "version": 1,
    "name": "Relative tolerance only",
    "variables": [
     {
      "name": "x",
      "type": "real",
      "shape": [
       4
      ],
      "lb": -3,
      "ub": 5
     },
     {
      "name": "y",
      "type": "real",
      "shape": [],
      "lb": 0,
      "ub": 4
     }
    ],
    "functions": "def spread(a):\n    total = 0\n    for i in range(len(a) - 1):\n        d = a[i + 1] - a[i]\n        total += d * d\n    return total\n",
    "objective": {
     "sense": "min",
     "source": "(x[0] - 2) * (x[0] - 2) + (x[1] - 1) * (x[1] - 1) + spread(x) + (y - 1.5) * (y - 1.5)"
    },
    "constraints": [
     {
      "name": "sum",
      "left": "x[0] + x[1]",
      "op": "<=",
      "right": "2"
     },
     {
      "name": "floor",
      "left": "x[2] * 100",
      "op": ">=",
      "right": "50 + y"
     },
     {
      "name": "tie",
      "left": "x[3] - x[2]",
      "op": "==",
      "right": "y / 4",
      "relative_tolerance": 0.1
     }
    ],
    "run": {
     "method": "sa",
     "settings": {
      "pop_size": 5
     },
     "budget": 3011,
     "seed": 81
    }
   }
