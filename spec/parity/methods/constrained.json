 "runs": [
  {
   "name": "constrained_pso",
   "ypea": {
    "class": "PSO",
    "kwargs": {
     "pop_size": 20
    }
   },
   "scales": [
    1.75,
    120.0,
    0.6
   ],
   "project": {
    "format": "ypea-studio-project",
    "version": 1,
    "name": "Constrained parity",
    "variables": [
     {
      "name": "x",
      "type": "real",
      "shape": [
       4
      ],
      "lb": -3,
      "ub": 5
     },
     {
      "name": "y",
      "type": "real",
      "shape": [],
      "lb": 0,
      "ub": 4
     }
    ],
    "functions": "def spread(a):\n    total = 0\n    for i in range(len(a) - 1):\n        d = a[i + 1] - a[i]\n        total += d * d\n    return total\n",
    "objective": {
     "sense": "min",
     "source": "(x[0] - 2) * (x[0] - 2) + (x[1] - 1) * (x[1] - 1) + spread(x) + (y - 1.5) * (y - 1.5)"
    },
    "constraints": [
     {
      "name": "sum",
      "left": "x[0] + x[1]",
      "op": "<=",
      "right": "2"
     },
     {
      "name": "floor",
      "left": "x[2] * 100",
      "op": ">=",
      "right": "50 + y"
     },
     {
      "name": "tie",
      "left": "x[3] - x[2]",
      "op": "==",
      "right": "y / 4",
      "tolerance": 0.05
     }
    ],
    "run": {
     "method": "pso",
     "settings": {
      "pop_size": 20
     },
     "budget": 3015,
     "seed": 40
    }
   }
  },
